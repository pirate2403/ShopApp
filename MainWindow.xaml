<Window x:Class="ShopApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Интернет-магазин · Лабораторная №1" Width="1280" Height="980" MinWidth="1000" MinHeight="650" Background="#F3F5F9" Foreground="#233044" FontFamily="Inter, Segoe UI" FontSize="14">
<ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="32">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,24"><Label Content="Интернет-магазин" FontSize="30" FontWeight="Bold"/><Label Content="Покупки и заказы · Вариант 2" Foreground="#667085"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="12" Padding="20"><StackPanel>
<Label Content="Новая покупка" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
<Label Content="Имя покупателя *" Target="{Binding ElementName=CustomerName}"/>
<TextBox x:Name="CustomerName" Padding="10" MaxLength="80" LostFocus="Name_LostFocus" TextChanged="Name_Changed" ToolTip="Обязательное поле: до 80 символов"/>
<Label Content="Категория" Margin="0,16,0,0"/><ComboBox x:Name="CategoryBox" Padding="8" SelectionChanged="Category_Changed" ToolTip="Выбор категории обновляет товары"/>
<Label Content="Товары" FontWeight="Bold" Margin="0,16,0,0"/><ListBox x:Name="ProductsList" Height="115" Padding="8" Background="#F3F5F9" BorderThickness="0" SelectionChanged="Options_Changed"/>
<GroupBox Header="Дополнительные услуги"><StackPanel><CheckBox x:Name="GiftBox" Content="Подарочная упаковка · 200 ₽" Click="Options_Changed"/><CheckBox x:Name="WarrantyBox" Content="Дополнительная гарантия · 1 000 ₽" Click="Options_Changed"/><CheckBox x:Name="InsuranceBox" Content="Страховка · 3% от цены" Click="Options_Changed"/></StackPanel></GroupBox>
<GroupBox Header="Получение покупки"><StackPanel><RadioButton x:Name="Pickup" Content="Самовывоз · бесплатно" GroupName="Delivery" IsChecked="True" Click="Options_Changed"/><RadioButton x:Name="Courier" Content="Курьер · 350 ₽ за покупку" GroupName="Delivery" Click="Options_Changed"/></StackPanel></GroupBox>
<Label x:Name="Preview" FontSize="18" FontWeight="Bold" Margin="0,16,0,8"/>
<Button Content="Добавить покупку" Click="Add_Click" HorizontalAlignment="Left" ToolTip="Добавить новую позицию в корзину"/>
<Button Content="Очистить форму" Click="Clear_Click" Background="Transparent" Foreground="#667085" HorizontalAlignment="Left" Margin="0,12,0,0"/>
</StackPanel></Border>
<Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" VerticalAlignment="Top"><StackPanel>
<DockPanel><Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" Background="Transparent" Foreground="#667085"/><Label Content="Корзина покупок" FontSize="20" FontWeight="Bold"/></DockPanel>
<Label Content="Выберите покупку, чтобы изменить или удалить её." Foreground="#667085" FontSize="13" Margin="0,16,0,8"/>
<ListBox x:Name="Cart" Height="200" Background="#F8FAFC" BorderThickness="0" SelectionChanged="Cart_Changed" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,10"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Id}"/><TextBlock Grid.Column="1" Text="{Binding Customer}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Product.Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding Amount}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<Border Background="#EEF3FF" CornerRadius="12" Padding="20" Margin="0,16"><TextBlock x:Name="Details" Text="Корзина пуста. Добавьте первую покупку." TextWrapping="Wrap" LineHeight="28"/></Border>
<WrapPanel><Button x:Name="UpdateButton" Content="Сохранить изменения" Click="Update_Click" IsEnabled="False"/><Button x:Name="DeleteButton" Content="Удалить запись" Click="Delete_Click" IsEnabled="False" Background="Transparent" Foreground="#233044"/></WrapPanel>
<Label x:Name="Total" FontSize="20" FontWeight="Bold" Margin="0,16"/>
<Border x:Name="StatusPanel" Background="#EAF6EF" CornerRadius="12" Padding="16"><Label x:Name="Status" Foreground="#16754A" Padding="0"><TextBlock Text="Заполните имя и выберите товар." TextWrapping="Wrap"/></Label></Border>
<Button Content="Очистить корзину" Click="ClearCart_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="#667085" Margin="0,16,0,0"/>
</StackPanel></Border></Grid>
<Label Grid.Row="2" Content="Лабораторная работа №1 · Данные хранятся до закрытия приложения" FontSize="12" Foreground="#667085" Margin="0,20,0,0"/>
</Grid></ScrollViewer></Window>
