<Application x:Class="ShopApp.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
 <SolidColorBrush x:Key="Ink" Color="#233044"/>
 <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="0,0,0,8"/></Style>
 <Style TargetType="Button"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#2C2C2C"/><Setter Property="Foreground" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,14,0,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,8,0,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="FontWeight" Value="Normal"/></Style>
 <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,7"/><Setter Property="FontWeight" Value="Normal"/></Style>
</Application.Resources></Application>
